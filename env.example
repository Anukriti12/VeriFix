# Copy to .env, fill in, then load it in your shell before running scripts:
#   set -a; source .env; set +a          (macOS / Linux)
# Never commit .env or paste keys into code.

# ---- Option A: your own GPU running vLLM (see README, "Set up the model") ----
VERIFIX_BASE_URL=http://localhost:8000/v1
VERIFIX_MODEL=Qwen/Qwen3-VL-8B-Instruct
VERIFIX_API_KEY=EMPTY

# ---- Option B: a hosted API (OpenRouter shown; any OpenAI-compatible API works) ----
# VERIFIX_BASE_URL=https://openrouter.ai/api/v1
# VERIFIX_MODEL=qwen/qwen3-vl-8b-instruct
# VERIFIX_API_KEY=<your OpenRouter key>

# ---- optional ----
# VERIFIX_MAX_IMAGE_SIDE=1280        # longest side of images sent to the model
# VERIFIX_FONTS_DIR=/path/to/fonts   # default: <repo>/fonts
# VERIFIX_CRELLO_DIR=crello_v5        # local Crello parquet files from scripts/download_crello.py
# HF_HOME=/big/disk/huggingface      # where the Crello download is cached
